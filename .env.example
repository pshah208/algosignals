# Flask
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=sqlite:///algosignals.db

# LLM / GitHub Models (optional — leave blank to use heuristic fallback)
# Get a free token at https://github.com/settings/tokens (fine-grained, no extra scopes needed)
GITHUB_TOKEN=
# GITHUB_MODELS_TOKEN=   # alias; GITHUB_TOKEN takes precedence
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4.1-mini
# LLM_AVAILABLE_MODELS=openai/gpt-4.1-mini,openai/gpt-4.1,openai/gpt-4o,openai/gpt-5,openai/gpt-5-mini,openai/o4-mini,anthropic/claude-sonnet-4.6,anthropic/claude-opus-4.6,microsoft/mai-code-1-flash,microsoft/phi-4
# LLM_BASE_URL=https://api.openai.com/v1   # uncomment to use OpenAI directly
# OPENAI_API_KEY=

# News provider (optional — app works without it via Google News RSS + VADER sentiment)
# NEWS_API_KEY=

# Scheduler (IST = UTC+5:30)
SCHEDULE_HOUR_IST=9
SCHEDULE_MINUTE_IST=0

# API auth key for GET /api/v1/recommendations
APP_API_KEY=change-me-api-key
