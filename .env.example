# Flask
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=sqlite:///algosignals.db

# Provider: models (OpenAI-compatible) or copilot (official GitHub Copilot SDK)
LLM_PROVIDER=models

# GitHub Models legacy configuration; service retired July 30, 2026.
# Historical fine-grained PAT permission: models:read. Not a Copilot login.
# Use a supported OpenAI-compatible endpoint, or configure copilot below.
GITHUB_TOKEN=
# GITHUB_MODELS_TOKEN=   # alias; GITHUB_TOKEN takes precedence
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4.1-mini
# LLM_AVAILABLE_MODELS=openai/gpt-4.1-mini,openai/gpt-4.1
# Configured model IDs are fallback suggestions, not a guaranteed provider catalog.
# LLM_BASE_URL=https://api.openai.com/v1   # uncomment to use OpenAI directly
# OPENAI_API_KEY=

# Copilot uses browser GitHub OAuth when configured below, never the Models PAT.
# Without OAuth only: copilot login as the OS account running Flask.
# Copilot entitlement required; preprovision: python -m copilot download-runtime
COPILOT_MODEL=gpt-4.1

# Optional GitHub OAuth app; both ID and secret enable browser sign-in.
# Register this callback on the OAuth app; use HTTPS and a strong SECRET_KEY in production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/auth/github/callback
# Tokens stay in a per-browser server memory vault (1h lifetime; restart requires sign-in).

# Optional trusted, separately installed read-only tradingview-mcp HTTP server:
# TRADINGVIEW_MCP_URL=http://127.0.0.1:8000/mcp

# News provider (optional — app works without it via Google News RSS + VADER sentiment)
# NEWS_API_KEY=

# Scheduler (IST = UTC+5:30)
SCHEDULE_HOUR_IST=9
SCHEDULE_MINUTE_IST=0

# Mandatory for Copilot status, research, and Copilot Run Now.
# Also protects GET /api/v1/recommendations when configured.
# Use a unique strong secret and appropriate deployment access controls.
APP_API_KEY=change-me-api-key
